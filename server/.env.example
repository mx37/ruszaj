# Ruszaj server configuration
# Copy to .env and adjust.

# HTTP server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Backend data provider (default: Transitous MOTIS API)
TRANSITOUS_BASE_URL=https://api.transitous.org

# Public app version (returned by /health)
APP_VERSION=0.1.0

# User-Agent sent to Transitous, as required by their usage policy.
# Must identify the app, its version and a way to contact us.
USER_AGENT=Ruszaj/0.1.0 (+https://github.com/mx37/ruszaj)
